#include <ESP8266WiFi.h>

const char* ssid = "om teke"; // Enter your WiFi SSID
const char* password = "12345678"; // Enter your WiFi Password

WiFiServer server(80);

// Relay Pin Definitions
#define RELAY_1 D1

void setup() {
  Serial.begin(115200);
  WiFi.begin(ssid, password);

  // Connect to WiFi
  Serial.print("Connecting to WiFi...");
  while (WiFi.status() != WL_CONNECTED) {
    delay(1000);
    Serial.print(".");
  }
  Serial.println("\nConnected!");
  Serial.print("IP Address: ");
  Serial.println(WiFi.localIP());

  server.begin();

  // Set relay pins as outputs
  pinMode(RELAY_1, OUTPUT);
  digitalWrite(RELAY_1, LOW); // Initially OFF
}

void loop() {
  WiFiClient client = server.available();
  if (!client) return;

  Serial.println("New Client Connected!");
  String request = client.readStringUntil('\r');
  client.flush();

  // Control Relays Based on Web Request
  if (request.indexOf("/relay1_on") != -1) {
    digitalWrite(RELAY_1, HIGH); // Turn ON 
    Serial.print("Turn ON ");
  }
  if (request.indexOf("/relay1_off") != -1) {
    digitalWrite(RELAY_1, LOW); // Turn OFF
    Serial.print("Turn OFF");
  }
 
  // Send HTML Webpage to Client
  client.println("HTTP/1.1 200 OK");
  client.println("Content-Type: text/html");
  client.println();
  client.println("<html><body>");
  client.println("<h2>IoT Web Controlled Home Automation</h2>");
  client.println("<p>Relay 1: <a href='/relay1_on'>ON</a> | <a href='/relay1_off'>OFF</a></p>");
  client.println("</body></html>");
  client.stop();
}
